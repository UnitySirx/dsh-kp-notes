{
  "name": "dsh-kp-notes",
  "version": "1.0.0",
  "type": "module",
  "description": "基于 DeepSeek Harness 开发的知识点(Knowledge Point)笔记插件",
  "author": "UnitySir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnitySirx/dsh-kp-notes.git",
    "directory": "plugin/rk-study"
  },
  "homepage": "https://github.com/UnitySirx/dsh-kp-notes#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "notes",
    "knowledge-base",
    "study",
    "canvas",
    "katex",
    "mermaid"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "系统架构设计师 · 学习画布",
    "description": "用 Markdown 笔记驱动的学习画布：每个章节一张卡片，点击查看详情，题目可遮挡答案自测"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./host": "./host.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.0-rc.1"
  },
  "files": [
    "client.js",
    "host.js",
    "lib/",
    "client/",
    "locale/",
    "vendor/",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
